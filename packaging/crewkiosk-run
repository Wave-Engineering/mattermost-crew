#!/usr/bin/env bash
# The kiosk's CLI runner (Dev Spec §5.11; Story 3.5; D-096, D-107). Install root-owned, mode 0755,
# at /usr/local/libexec/crewkiosk-run. The daemon never runs it: it connects to
# /run/crewkiosk/kiosk.sock (packaging/crewkiosk.socket, Accept=yes), and systemd starts one
# packaging/crewkiosk@.service instance per connection, as crewkiosk, with this script's stdin
# and stdout on that connection. The daemon keeps NoNewPrivileges=yes and never changes user.
#
# It reads the prompt on stdin, to EOF (the daemon half-closes), and replies on stdout with
# `ok` and the answer, or `error <rc>`: a socket carries no exit status. Its own refusals go
# to stderr, which is the instance's journal, and reach the daemon as no reply at all. It:
#   - refuses to run as anyone but crewkiosk;
#   - drops every inherited environment variable;
#   - gives the CLI an empty HOME and an empty working directory, fresh for every question and
#     removed afterwards, so no user, project or local settings, hooks, skills, CLAUDE.md or
#     earlier session can load;
#   - hands the CLI only the kiosk's model credential, /etc/crewkiosk/model.credential
#     (0600, crewkiosk:crewkiosk; spike 1.2), never any chat or broker credential. Its first
#     line is the key alone, or `ANTHROPIC_API_KEY=<key>`; any other `=` or any whitespace in
#     the key is refused;
#   - reads /etc/crewkiosk/model.conf (0640, root:crewkiosk; optional, never sourced), whose
#     only keys are `base_url` (an https model gateway, exported as ANTHROPIC_BASE_URL) and
#     `model` (default claude-haiku-5-5). It always pins the model: `--model` and every model
#     variable Claude Code reads, so no alias or background call can name a model the gateway
#     refuses. Those variables must hold a full model name, never an alias (Claude Code's model
#     configuration), so with no gateway a bare alias such as `haiku` is refused;
#   - runs `claude -p --restricted --strict-mcp-config --tools "" --disallowedTools "mcp__*"
#     --settings '{"switchModelsOnFlag":false}' --model <pin>`, so the model has no tool and
#     no MCP server to call, and a request the safety classifiers flag ends as an error rather
#     than re-running on another model.
# Exit codes, before the CLI runs: 64 the wrong user, 65 the credential, 66 model.conf.
# The kiosk host must have no local or remote (org-pushed) managed Claude Code settings: they
# still apply under --restricted (§5.11, spike 1.2).
set -euo pipefail

KIOSK_USER=crewkiosk
CREDENTIAL=/etc/crewkiosk/model.credential
MODEL_CONF=/etc/crewkiosk/model.conf
CLAUDE=/usr/local/bin/claude
KIOSK_PATH=/usr/local/bin:/usr/bin:/bin
DEFAULT_MODEL=claude-haiku-5-5
# Claude Code's own aliases: the model variables would pass them to the API as model IDs.
CLAUDE_ALIASES=" default best fable sonnet opus haiku opusplan "

if [[ "$(id -un)" != "$KIOSK_USER" ]]; then
  echo "crewkiosk-run: must run as $KIOSK_USER" >&2
  exit 64
fi

# Nothing inherited reaches the CLI.
while IFS= read -r name; do
  unset "$name" 2>/dev/null || true
done < <(compgen -e)
export PATH="$KIOSK_PATH"
umask 077

# model.conf: KEY=value lines, read, never sourced. A missing file is the defaults; one that
# exists but can't be read is a refusal, never a silent fall back to the default endpoint.
base_url=""
model="$DEFAULT_MODEL"
if [[ -e "$MODEL_CONF" ]]; then
  if [[ ! -r "$MODEL_CONF" ]]; then
    echo "crewkiosk-run: cannot read $MODEL_CONF" >&2
    exit 66
  fi
  n=0
  while IFS='=' read -r k v || [[ -n "$k" ]]; do
    n=$((n + 1))
    [[ "$k" =~ ^[[:space:]]*$ && -z "$v" ]] && continue # a blank line
    [[ "$k" =~ ^[[:space:]]*# ]] && continue             # a comment
    case "$k" in
      base_url)
        if [[ ! "$v" =~ ^https://[^[:space:]]+$ ]]; then
          echo "crewkiosk-run: $MODEL_CONF: base_url must be an https URL with no spaces" >&2
          exit 66
        fi
        base_url="$v"
        ;;
      model)
        if [[ ! "$v" =~ ^[A-Za-z0-9._:-]+$ ]]; then
          echo "crewkiosk-run: $MODEL_CONF: model may hold only A-Z a-z 0-9 . _ : -" >&2
          exit 66
        fi
        model="$v"
        ;;
      *)
        # The line number, never the text: a key pasted here by mistake has no `=` to split.
        echo "crewkiosk-run: $MODEL_CONF line $n: unknown key (only base_url and model)" >&2
        exit 66
        ;;
    esac
  done <"$MODEL_CONF"
fi
if [[ -z "$base_url" && "$CLAUDE_ALIASES" == *" ${model,,} "* ]]; then
  echo "crewkiosk-run: $MODEL_CONF: with no base_url, model must be a full model name such as $DEFAULT_MODEL, not the alias '$model'" >&2
  exit 66
fi

# The credential's first line: the key alone, or ANTHROPIC_API_KEY=<key>.
if [[ ! -r "$CREDENTIAL" ]]; then
  echo "crewkiosk-run: cannot read $CREDENTIAL" >&2
  exit 65
fi
# No final newline still reads the line; an empty file is refused below, with 65.
IFS= read -r ANTHROPIC_API_KEY <"$CREDENTIAL" || true
ANTHROPIC_API_KEY="${ANTHROPIC_API_KEY#ANTHROPIC_API_KEY=}"
if [[ "$ANTHROPIC_API_KEY" == *=* || "$ANTHROPIC_API_KEY" =~ [[:space:]] ]]; then
  # A CRLF line ending or padding is whitespace: the key itself has none.
  echo "crewkiosk-run: $CREDENTIAL must hold the key alone, or ANTHROPIC_API_KEY=<key>, with no = or whitespace in the key" >&2
  exit 65
fi
if [[ -z "${ANTHROPIC_API_KEY:-}" ]]; then
  echo "crewkiosk-run: $CREDENTIAL is empty" >&2
  exit 65
fi
export ANTHROPIC_API_KEY

# The gateway, if any, and the pinned model, in every place Claude Code reads one.
if [[ -n "$base_url" ]]; then
  export ANTHROPIC_BASE_URL="$base_url"
fi
export ANTHROPIC_MODEL="$model"
export ANTHROPIC_DEFAULT_HAIKU_MODEL="$model"
export ANTHROPIC_DEFAULT_SONNET_MODEL="$model"
export ANTHROPIC_DEFAULT_OPUS_MODEL="$model"
export ANTHROPIC_DEFAULT_FABLE_MODEL="$model"
export ANTHROPIC_SMALL_FAST_MODEL="$model"

scratch="$(mktemp -d -t crewkiosk.XXXXXXXX)"
trap 'rm -rf "$scratch"' EXIT
mkdir -m 0700 "$scratch/home" "$scratch/work" "$scratch/io"
cat >"$scratch/io/prompt"
export HOME="$scratch/home"
cd "$scratch/work"

rc=0
"$CLAUDE" -p --restricted --strict-mcp-config --tools "" --disallowedTools "mcp__*" --settings '{"switchModelsOnFlag":false}' --model "$model" <"$scratch/io/prompt" >"$scratch/io/answer" || rc=$?
if [[ "$rc" -eq 0 ]]; then
  printf 'ok\n'
  cat "$scratch/io/answer"
else
  echo "crewkiosk-run: claude exited $rc" >&2
  printf 'error %d\n' "$rc"
fi
