# The mattermost-crew chat daemon: one per host (Dev Spec §4.1, §5.3).
#
#   systemctl enable --now crewchat
#
# Needs the crewchat user, the crewchat-clients group (crewchat is a member), and
# /etc/crewchat/servers.toml. systemd creates /run/crewchat (RuntimeDirectory, kept across daemon
# restarts; /run is emptied on every boot) and /var/lib/crewchat (StateDirectory, mode 0700). The daemon creates
# /var/lib/crewchat/tokens and /var/lib/crewchat/threads (0700) and every file in them (0600), and gives its socket,
# /run/crewchat/crewchat.sock, mode 0660 and group crewchat-clients. It reaches each broker's
# socket under /run/crewbroker through the crewchat group (packaging/crewbroker.tmpfiles.conf).
# It reaches the kiosk the same way, through /run/crewkiosk/kiosk.sock (packaging/crewkiosk.socket):
# the kiosk runs as crewkiosk without the daemon changing user, so NoNewPrivileges stays (D-107).
[Unit]
Description=mattermost-crew chat daemon
Wants=network-online.target crewkiosk.socket
After=network-online.target crewkiosk.socket

[Service]
Type=simple
User=crewchat
Group=crewchat
SupplementaryGroups=crewchat-clients
ExecStart=/opt/mattermost-crew/.venv/bin/crewchat serve
Restart=on-failure
RestartSec=5
UMask=0077
ProtectSystem=strict
RuntimeDirectory=crewchat
# The agents' user must traverse /run/crewchat to reach the socket; the socket itself is 0660.
RuntimeDirectoryMode=0755
# Kept across restarts, so a container's bind mount of /run/crewchat stays valid (#173). /run still empties on boot.
RuntimeDirectoryPreserve=yes
StateDirectory=crewchat
StateDirectoryMode=0700
ReadWritePaths=/var/lib/crewchat /run/crewchat
# The kiosk's corpus pool manifests (#139), only on a host with kiosk research: `-`, so a host
# without packaging/crewchat-pool.tmpfiles.conf still starts.
ReadWritePaths=-/var/lib/crewchat-pool
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
