{
  "about": "Shared fixture for sqtk-doorbell.sh's predicate (Story 3.2, R-26). Each case is one SSE event and the squawk ids from the agent's squawk records (numbers, as sqtk-doorbell.sh reads them). `rings` is whether sqtk-doorbell.sh's jq rings for it. tests/unit/daemon/test_squawkie.py holds the daemon's `rings` and the script's jq, verbatim, to every case.",
  "jq": "def answer: (split(\"→\") | if length > 1 then .[-1] | gsub(\"^\\\\s+|\\\\s+$\"; \"\") else \"\" end);\n.type == \"squawk.updated\" and (.squawk.id as $i | $ids | index($i)) != null\nand (.squawk.state != \"open\" or (.squawk.text | answer) != \"\")",
  "cases": [
    {"name": "open, answered after the arrow", "ids": [5], "rings": true,
     "event": {"type": "squawk.updated", "squawk": {"id": 5, "state": "open", "text": "deploy now? → yes"}}},
    {"name": "open, no arrow", "ids": [5], "rings": false,
     "event": {"type": "squawk.updated", "squawk": {"id": 5, "state": "open", "text": "deploy now?"}}},
    {"name": "open, an arrow with nothing after it", "ids": [5], "rings": false,
     "event": {"type": "squawk.updated", "squawk": {"id": 5, "state": "open", "text": "deploy now? → "}}},
    {"name": "open, only whitespace after the arrow", "ids": [5], "rings": false,
     "event": {"type": "squawk.updated", "squawk": {"id": 5, "state": "open", "text": "deploy now? →  \t "}}},
    {"name": "open, only a no-break space after the arrow", "ids": [5], "rings": false,
     "event": {"type": "squawk.updated", "squawk": {"id": 5, "state": "open", "text": "deploy now? → "}}},
    {"name": "open, the answer is after the last arrow", "ids": [5], "rings": true,
     "event": {"type": "squawk.updated", "squawk": {"id": 5, "state": "open", "text": "a → b → c"}}},
    {"name": "open, an arrow in the prose and an empty last slot", "ids": [5], "rings": false,
     "event": {"type": "squawk.updated", "squawk": {"id": 5, "state": "open", "text": "a → b → "}}},
    {"name": "confirmed, no answer", "ids": [5], "rings": true,
     "event": {"type": "squawk.updated", "squawk": {"id": 5, "state": "confirmed", "text": "deploy now?"}}},
    {"name": "retired, text missing", "ids": [5], "rings": true,
     "event": {"type": "squawk.updated", "squawk": {"id": 5, "state": "retired"}}},
    {"name": "open, text missing", "ids": [5], "rings": false,
     "event": {"type": "squawk.updated", "squawk": {"id": 5, "state": "open"}}},
    {"name": "someone else's squawk", "ids": [5], "rings": false,
     "event": {"type": "squawk.updated", "squawk": {"id": 6, "state": "confirmed", "text": "x → y"}}},
    {"name": "one of several ids", "ids": [3, 5, 9], "rings": true,
     "event": {"type": "squawk.updated", "squawk": {"id": 9, "state": "rejected", "text": "x"}}},
    {"name": "no ids", "ids": [], "rings": false,
     "event": {"type": "squawk.updated", "squawk": {"id": 5, "state": "confirmed", "text": "x"}}},
    {"name": "the id as a string", "ids": [5], "rings": false,
     "event": {"type": "squawk.updated", "squawk": {"id": "5", "state": "confirmed", "text": "x"}}},
    {"name": "the id as 5.0", "ids": [5], "rings": true,
     "event": {"type": "squawk.updated", "squawk": {"id": 5.0, "state": "confirmed", "text": "x"}}},
    {"name": "a created event, answered", "ids": [5], "rings": false,
     "event": {"type": "squawk.created", "squawk": {"id": 5, "state": "open", "text": "x → y"}}},
    {"name": "a deleted event", "ids": [5], "rings": false,
     "event": {"type": "squawk.deleted", "id": 5}},
    {"name": "no squawk", "ids": [5], "rings": false,
     "event": {"type": "squawk.updated"}}
  ]
}
